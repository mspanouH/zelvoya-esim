# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Pooled connection. Used by the app at runtime. Note the "-pooler" in the host.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/zelvoya?sslmode=require"

# Direct (unpooled) connection. Used by Prisma Migrate only.
# Migrations need a real session, which a connection pooler cannot give them.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/zelvoya?sslmode=require"

# ---------------------------------------------------------------------------
# Application secrets
# ---------------------------------------------------------------------------
# Shared secret between the mock payment service and this app. The payment
# service signs each callback with it; the callback route verifies the signature
# before touching the order.
# Generate one with: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-string"

# Signs the customer/admin session cookie.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# ---------------------------------------------------------------------------
# Public configuration
# ---------------------------------------------------------------------------
# Base URL of this app. Used to build the URL the mock payment service posts
# its callback to. Set to the Vercel URL in production.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
